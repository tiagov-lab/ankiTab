{
	"name": "AnkiTab",
	"version": "0.8.0",
	"description": "Replace new tab page with Anki flashcards",
	"manifest_version": 2,
	"browser_specific_settings": {
		"gecko": {
			"id": "ankitab@tiagov-lab.github.io",
			"strict_min_version": "128.0",
			"data_collection_permissions": {
				"required": ["none"]
			}
		}
	},
	"background": {
		"scripts": ["bg.js"]
	},
	"browser_action": {
		"default_icon": {
			"16": "icons/16.png",
			"24": "icons/24.png",
			"32": "icons/32.png"
		},
		"default_title": "AnkiTab"
	},
	"icons": {
		"16": "icons/16.png",
		"48": "icons/48.png",
		"128": "icons/128.png"
	},
	"permissions": [
		"storage",
		"http://127.0.0.1:8765/*",
		"http://localhost:8765/*"
	],
	"optional_permissions": [
		"topSites"
	],
	"content_security_policy": "script-src 'self' 'unsafe-eval'; object-src 'self'",
	"chrome_url_overrides": {
		"newtab": "app/index.html"
	},
	"options_ui": {
		"page": "options/index.html",
		"open_in_tab": true
	}
}
